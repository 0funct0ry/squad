---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const year = new Date().getFullYear();
---
<footer class="border-t border-border-subtle py-16">
  <div class="container-page grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <div class="flex items-center gap-2 font-bold text-lg text-fg-primary">
        <span class="inline-flex h-6 w-6 items-center justify-center rounded-md border border-border-subtle">
          <svg viewBox="0 0 32 32" class="h-3.5 w-3.5" fill="none">
            <path d="M9 12c0-1.657 1.79-3 4-3h6c2.21 0 4 1.343 4 3s-1.79 3-4 3h-6c-2.21 0-4 1.343-4 3s1.79 3 4 3h6c2.21 0 4-1.343 4-3" stroke="#22d3ee" stroke-width="2.6" stroke-linecap="round"/>
          </svg>
        </span>
        squad
      </div>
      <p class="mt-3 text-sm text-fg-muted max-w-xs">
        A minimal, single-binary, web-based SQLite client.
      </p>
    </div>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wide text-fg-disabled">Product</h4>
      <ul class="mt-3 space-y-2 text-sm text-fg-muted">
        <li><a href={`${base}docs/`} class="hover:text-fg-primary transition-colors">Docs</a></li>
        <li><a href="https://github.com/0funct0ry/squad" target="_blank" rel="noreferrer" class="hover:text-fg-primary transition-colors">GitHub</a></li>
        <li><a href="https://github.com/0funct0ry/squad/releases" target="_blank" rel="noreferrer" class="hover:text-fg-primary transition-colors">Releases</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wide text-fg-disabled">Community</h4>
      <ul class="mt-3 space-y-2 text-sm text-fg-muted">
        <li><a href="https://github.com/0funct0ry/squad/issues" target="_blank" rel="noreferrer" class="hover:text-fg-primary transition-colors">Issues</a></li>
        <li><a href="https://github.com/0funct0ry/squad/discussions" target="_blank" rel="noreferrer" class="hover:text-fg-primary transition-colors">Discussions</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-wide text-fg-disabled">License</h4>
      <ul class="mt-3 space-y-2 text-sm text-fg-muted">
        <li><a href="https://github.com/0funct0ry/squad/blob/main/LICENSE" target="_blank" rel="noreferrer" class="hover:text-fg-primary transition-colors">MIT License</a></li>
      </ul>
    </div>
  </div>
  <div class="container-page mt-12 text-xs text-fg-disabled">
    &copy; {year} 0funct0ry
  </div>
</footer>
